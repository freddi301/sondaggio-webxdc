{
  "$schema": "https://inlang.com/schema/inlang-message-format",
  "app_name": "Sondaggio",
  "title_placeholder": "Title",
  "description_placeholder": "Description",
  "option_placeholder": "Option",
  "votes_summary": [
    {
      "declarations": ["input count", "local countPlural = count: plural"],
      "selectors": ["countPlural"],
      "match": {
        "countPlural=one": "1 vote",
        "countPlural=other": "{count} votes"
      }
    }
  ],
  "history_view_button": "View edit history",
  "history_back_button": "Back to poll",
  "history_heading": "Edit history",
  "history_empty": "No edits yet",
  "history_checked": "checked",
  "history_unchecked": "unchecked",
  "history_field_title": "title",
  "history_field_description": "description",
  "history_field_option": "option"
}
